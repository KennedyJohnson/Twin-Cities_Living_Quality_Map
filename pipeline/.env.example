# Census API key (required for employment/housing/affordability metrics)
# Get free key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# St. Paul Socrata dataset IDs (optional - leave blank to use local CSVs)
# Discover IDs at: https://information.stpaul.gov/browse
# Extract ID from dataset URL (e.g., /api/views/{id}/rows.json)
STPAUL_CRIME_ID=
STPAUL_PERMITS_ID=
STPAUL_REQUESTS_ID=
STPAUL_HOUSING_ID=
