# Census API key (required for employment/housing/affordability metrics)
# Get free key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# Note: St. Paul and Minneapolis data are fetched from ArcGIS FeatureServer APIs automatically
# No additional configuration needed - the pipeline uses hardcoded service URLs
# If APIs are unavailable, the pipeline will fall back to local CSV files in /data/
